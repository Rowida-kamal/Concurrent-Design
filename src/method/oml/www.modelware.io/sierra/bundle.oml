
@dc:title "Concurrent Design bundle"
@dc:description "A packaging bundle that includes all vocabularies required for concurrent design modeling and analysis."

vocabulary bundle <https://www.modelware.io/sierra/bundle#> as v-bundle {
    includes <http://purl.org/dc/elements/1.1/> as dc
    includes <https://www.modelware.io/sierra/base#>
    includes <https://www.modelware.io/sierra/mission#>
    includes <https://www.modelware.io/sierra/entity#>
    includes <https://www.modelware.io/sierra/process#>
    includes <https://www.modelware.io/sierra/stakeholder#>
    includes <https://www.modelware.io/sierra/requirements#>
    includes <https://www.modelware.io/sierra/session#>
    includes <https://www.modelware.io/sierra/state#>
    includes <https://www.modelware.io/sierra/component#>
    // project-specific vocabulary added by this project
    includes <https://context-analysis/method/parameters#>
}
