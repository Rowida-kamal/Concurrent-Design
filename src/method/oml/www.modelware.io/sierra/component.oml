
@dc:title "Component Vocabulary"
@dc:description "Defines satellite components, subsystems, physical parts, interfaces, ports and exchanges of data, material and energy for concurrent design."

vocabulary <https://www.modelware.io/sierra/component#> as component {
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <https://www.modelware.io/sierra/base#> as base
    extends <http://opencaesar.io/isq/> as isq

    @dc:description "A component is a part of the satellite system."
    concept Component < base:Container, base:Contained, base:Element

    @dc:description "A physical part of the satellite system."
    concept PhysicalPart < Component

    @dc:description "The mass of a physical part."
    quantity property mass [
        domain PhysicalPart
        quantity isq:Mass
        functional
    ]

    @dc:description "A functional group of components that performs a specific role in the satellite system."
    concept Subsystem < Component

    @dc:description "Indicates that a component belongs to a subsystem."
    relation belongsToSubsystem [
        from Component
        to Subsystem
        reverse containsComponent
    ]

    @dc:description "An interface through which components exchange information, material or energy."
    concept Interface < base:Element

    @dc:description "A port is an interaction point of a component."
    concept Port < base:Contained, base:Element

    @dc:description "Indicates that a component has a port."
    relation hasPort [
        from Component
        to Port
        reverse portOf
        inverse functional
    ]

    @dc:description "Port direction."
    scalar Direction [
        oneOf "In", "Out"
    ]

    @dc:description "The direction of a port."
    scalar property direction [
        domain Port
        range Direction
        functional
    ]

    @dc:description "Represents a connection between two ports."
    relation entity Connection [
        from Port
        to Port
        forward connectedTo
    ] < base:Element

    concept Signal < base:Item

    concept Material < base:Item

    concept Energy < base:Item

    @dc:description "Indicates the item transferred through a connection."
    relation transfers [
        from Connection
        to base:Item
        reverse isTransferredBy
    ]
}
