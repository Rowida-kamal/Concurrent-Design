
@dc:title "Process Vocabulary"
@dc:description "Defines the concurrent design process, engineering activities, data products and information flows exchanged during mission design."

vocabulary <https://www.modelware.io/sierra/process#> as process {
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <https://www.modelware.io/sierra/base#> as base
    extends <https://www.modelware.io/sierra/mission#> as mission
    extends <https://www.modelware.io/sierra/entity#> as ^entity

    @dc:description "A concurrent design process composed of engineering activities and data flows."
    concept Process < base:Element

    @dc:description "An engineering activity performed during the concurrent design process."
    concept Activity < base:Element

    @dc:description "A piece of engineering information produced, exchanged or used during the concurrent design process, such as a design parameter, analysis result or technical budget."
    concept DataProduct < base:Item

    @dc:description "Connects a process to the mission capability it describes."
    relation describes [
        from Process
        to mission:Capability
        reverse isDescribedBy
    ]

    @dc:description "A process includes flows between activities."
    relation ^includes [
        from Process
        to Flow
        reverse isIncludedIn
    ]

    @dc:description "A flow represents the exchange of data between two engineering activities."
    relation entity Flow [
        from Activity
        to Activity
        forward flowsTo
        reverse flowsFrom
        irreflexive
    ] < base:Element

    @dc:description "A flow carries engineering data between activities."
    relation flows [
        from Flow
        to DataProduct
        reverse isCarriedBy
    ]

    @dc:description "An activity may be allocated to an entity responsible for performing it."
    relation isAllocatedTo [
        from Activity
        to entity:Entity
        reverse isResponsibleFor
    ]
}
